{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM"],
        "types": ["vite/client"],
        "strict": true,
        "allowJs": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
