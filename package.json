{
    "name": "hodl-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.3.4",
    "scripts": {
        "build": "pnpm --filter hodl-wallet run build",
        "start": "pnpm --filter hodl-wallet run start",
        "typecheck": "pnpm --filter hodl-wallet run typecheck",
        "test": "pnpm --filter hodl-wallet run test",
        "test:network": "pnpm --filter hodl-wallet run test:network",
        "test:integration": "pnpm --filter hodl-wallet run test:integration",
        "test:persist": "pnpm --filter hodl-wallet run test:persist",
        "test:agent": "pnpm --filter hodl-wallet run test:agent",
        "test:transfer": "pnpm --filter hodl-wallet run test:transfer",
        "test:swap": "pnpm --filter hodl-wallet run test:swap",
        "test:quick": "pnpm --filter hodl-wallet run test:quick",
        "prepublishOnly": "pnpm --filter hodl-wallet run prepublishOnly"
    }
}
